{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "typeRoots": ["../host/node_modules/@types"],
    "types": ["bun"]
  },
  "include": ["**/*.ts", "../host/vault.d.ts"],
  "exclude": ["node_modules"]
}
