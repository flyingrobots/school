{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/components/example": ["./src/demo/example.tsx"],
      "next/link": ["./src/demo/shims/next-link.tsx"],
      "next/image": ["./src/demo/shims/next-image.tsx"],
      "@/app/(create)/lib/search-params": ["./src/demo/shims/search-params.ts"],
      "@/components/message-parts": ["./src/demo/shims/message-parts.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
