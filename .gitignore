# SQLite runtime state. The schema is created by server/server.ts on boot,
# so the database file is regenerated and must never be committed.
# Learner state is external now (SCHOOL_STATE); this covers a local default.
state/
progress/
*.db
*.db.bak-*
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

