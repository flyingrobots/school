{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "school.launcher.done/1.0.0",
  "title": "Done",
  "description": "On stdout, last, before exit 0.",
  "type": "object",
  "properties": {
    "_schema": {
      "type": "object",
      "description": "The schema this line follows.",
      "properties": {
        "id": {
          "const": "school.launcher.done"
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "kind": {
      "enum": [
        "school.up",
        "school.down",
        "school.compose",
        "school.import"
      ],
      "description": "The command that printed the line: school.<command>, school.help or school.error."
    },
    "event": {
      "const": "done"
    },
    "run": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "One random (version 4) UUID per invocation, on every line it prints."
    },
    "ok": {
      "const": true
    },
    "imported": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "For import: the secrets moved into the Keychain."
    }
  },
  "required": [
    "_schema",
    "kind",
    "event",
    "run",
    "ok"
  ],
  "additionalProperties": false
}
