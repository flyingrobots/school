{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "school.launcher.exit-codes/1.0.0",
  "title": "Exit codes",
  "description": "On stdout, last line of --help: what each exit code means.",
  "type": "object",
  "properties": {
    "_schema": {
      "type": "object",
      "description": "The schema this line follows.",
      "properties": {
        "id": {
          "const": "school.launcher.exit-codes"
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "kind": {
      "enum": [
        "school.help"
      ],
      "description": "The command that printed the line: school.<command>, school.help or school.error."
    },
    "event": {
      "const": "exit-codes"
    },
    "run": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "One random (version 4) UUID per invocation, on every line it prints."
    },
    "exitCodes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "_schema",
    "kind",
    "event",
    "run",
    "exitCodes"
  ],
  "additionalProperties": false
}
