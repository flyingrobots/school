{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "school.launcher.compose/1.0.0",
  "title": "Compose output",
  "description": "On stdout: one line docker compose printed, scrubbed of every secret.",
  "type": "object",
  "properties": {
    "_schema": {
      "type": "object",
      "description": "The schema this line follows.",
      "properties": {
        "id": {
          "const": "school.launcher.compose"
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "kind": {
      "enum": [
        "school.up",
        "school.down",
        "school.compose"
      ],
      "description": "The command that printed the line: school.<command>, school.help or school.error."
    },
    "event": {
      "const": "compose"
    },
    "run": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "One random (version 4) UUID per invocation, on every line it prints."
    },
    "stream": {
      "enum": [
        "stdout",
        "stderr"
      ]
    },
    "line": {
      "type": "string"
    }
  },
  "required": [
    "_schema",
    "kind",
    "event",
    "run",
    "stream",
    "line"
  ],
  "additionalProperties": false
}
