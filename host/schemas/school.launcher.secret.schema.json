{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "school.launcher.secret/1.0.0",
  "title": "Secret resolved",
  "description": "On stdout: where one secret came from. Never its value.",
  "type": "object",
  "properties": {
    "_schema": {
      "type": "object",
      "description": "The schema this line follows.",
      "properties": {
        "id": {
          "const": "school.launcher.secret"
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "kind": {
      "enum": [
        "school.up",
        "school.compose"
      ],
      "description": "The command that printed the line: school.<command>, school.help or school.error."
    },
    "event": {
      "const": "secret"
    },
    "run": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "One random (version 4) UUID per invocation, on every line it prints."
    },
    "name": {
      "type": "string"
    },
    "from": {
      "enum": [
        "environment",
        "keychain",
        "prompted",
        "generated"
      ]
    }
  },
  "required": [
    "_schema",
    "kind",
    "event",
    "run",
    "name",
    "from"
  ],
  "additionalProperties": false
}
