# Copy to server/.env (gitignored) and edit. Paths are relative to server/.
SCHOOL_COURSE_DIR=../../my-course
# Settings (settings.json) live here. If an old SQLite progress.db here still holds answers,
# explanations or views, the server refuses to start rather than leave them behind (RFC 3 §3.3).
SCHOOL_STATE_DIR=../../my-school-state
# Source material the course cites, mounted read-only at /sources and served at /papers/...
SCHOOL_SOURCES_DIR=../../my-course-sources
SCHOOL_MOUNTS=papers=/sources

# The password of the Postgres superuser in the `postgres` service. compose builds the server's
# SCHOOL_DATABASE_URL from it (postgres://postgres:<this>@postgres:5432/school); the record itself
# lives in the named volume `postgres`. Generate one, e.g. `openssl rand -base64 32 | tr -d '/+='`,
# and keep it: the volume is initialised with the first one. Use letters and digits only, since it
# is put into a URL as it is.
SCHOOL_POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# Outside compose, SCHOOL_DATABASE_URL picks the record directly: postgres://user:pw@host:5432/db
# (Bun.SQL; the user must be able to create roles, in practice the superuser) or pglite:<dir>
# (PGlite on disk, no server). Unset, it is pglite:<SCHOOL_STATE>/db.

# The name School is reached by on your tailnet. Without it, every request through
# `tailscale serve` is refused; only localhost works.
SCHOOL_ALLOWED_HOSTS=school.example.ts.net

# Explanation grading. The bridge runs on the host (bun bridge/bridge.ts) with the same token;
# leave these unset to save explanations without grading them.
# SCHOOL_BRIDGE_URL=http://host.docker.internal:4748
# SCHOOL_BRIDGE_TOKEN=a-long-random-secret
