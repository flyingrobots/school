# Copy to server/.env (gitignored) and edit. Paths are relative to server/.
SCHOOL_COURSE_DIR=../../my-course
SCHOOL_STATE_DIR=../../my-school-state
# Source material the course cites, mounted read-only at /sources and served at /papers/...
SCHOOL_SOURCES_DIR=../../my-course-sources
SCHOOL_MOUNTS=papers=/sources

# Explanation grading. Pick one, or leave SCHOOL_GRADER unset to save explanations ungraded.
# Hosted: the Anthropic Messages API (model defaults to claude-opus-5-5).
# SCHOOL_GRADER=anthropic
# SCHOOL_GRADER_API_KEY=sk-ant-...
# Local: LM Studio or Ollama on the host, reached from the container.
# SCHOOL_GRADER=openai-compatible
# SCHOOL_GRADER_URL=http://host.docker.internal:1234/v1
# SCHOOL_GRADER_MODEL=your-loaded-model
