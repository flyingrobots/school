{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "school.backup.waiting/1.0.0",
  "title": "Waiting",
  "description": "On stdout, on the schedule: the next dump is in `seconds` (the interval, or five minutes after a failed dump).",
  "type": "object",
  "properties": {
    "_schema": {
      "type": "object",
      "description": "The schema this line follows.",
      "properties": {
        "id": {
          "const": "school.backup.waiting"
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "kind": {
      "const": "backup",
      "description": "The program (or, for the bridge, the message type) that printed the line."
    },
    "event": {
      "const": "waiting"
    },
    "run": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "One id per invocation (for the bridge, per process), on every line it prints."
    },
    "seconds": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "_schema",
    "kind",
    "event",
    "run",
    "seconds"
  ],
  "additionalProperties": false
}
