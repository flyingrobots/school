{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "school.backup.captured/1.0.0",
  "title": "Captured",
  "description": "On stderr: what pg_dump printed on its stderr during a dump that succeeded (a warning, say), wrapped as a line instead of passed through. The password is scrubbed from it.",
  "type": "object",
  "properties": {
    "_schema": {
      "type": "object",
      "description": "The schema this line follows.",
      "properties": {
        "id": {
          "const": "school.backup.captured"
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "kind": {
      "const": "backup",
      "description": "The program (or, for the bridge, the message type) that printed the line."
    },
    "event": {
      "const": "captured"
    },
    "run": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "One id per invocation (for the bridge, per process), on every line it prints."
    },
    "stream": {
      "const": "stderr"
    },
    "command": {
      "const": "pg_dump"
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "_schema",
    "kind",
    "event",
    "run",
    "stream",
    "command",
    "text"
  ],
  "additionalProperties": false
}
