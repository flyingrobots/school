{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "school.backup.started/1.0.0",
  "title": "Started",
  "description": "On stdout, once, when the schedule starts (not with `once`).",
  "type": "object",
  "properties": {
    "_schema": {
      "type": "object",
      "description": "The schema this line follows.",
      "properties": {
        "id": {
          "const": "school.backup.started"
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "kind": {
      "const": "backup",
      "description": "The program (or, for the bridge, the message type) that printed the line."
    },
    "event": {
      "const": "started"
    },
    "run": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "One id per invocation (for the bridge, per process), on every line it prints: a random (version 4) UUID."
    },
    "intervalSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "keep": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "_schema",
    "kind",
    "event",
    "run",
    "intervalSeconds",
    "keep"
  ],
  "additionalProperties": false
}
