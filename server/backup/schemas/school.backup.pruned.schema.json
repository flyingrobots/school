{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "school.backup.pruned/1.0.0",
  "title": "Pruned",
  "description": "On stdout, after a good dump: an older dump was deleted by the retention.",
  "type": "object",
  "properties": {
    "_schema": {
      "type": "object",
      "description": "The schema this line follows.",
      "properties": {
        "id": {
          "const": "school.backup.pruned"
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "kind": {
      "const": "backup",
      "description": "The program (or, for the bridge, the message type) that printed the line."
    },
    "event": {
      "const": "pruned"
    },
    "run": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "One id per invocation (for the bridge, per process), on every line it prints."
    },
    "file": {
      "type": "string",
      "pattern": "^school-\\d{8}T\\d{6}Z\\.dump$",
      "description": "The dump's name in /backups."
    }
  },
  "required": [
    "_schema",
    "kind",
    "event",
    "run",
    "file"
  ],
  "additionalProperties": false
}
